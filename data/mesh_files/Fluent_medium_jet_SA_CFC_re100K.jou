; 1. GROUND FORCE REPORT
/solve/report-definitions/add ground-force force thread-names ground () force 0 1 0 per-zone? no q
/solve/report-files/add ground-force-file report-defs ground-force () print yes file-name Medium_jet_SA_tv5_CFC_re100K_tv5_ground_force_data.csv q
/solve/report-plots/add ground-force-plot report-defs ground-force () active yes q q


; 2. MASS FLUX REPORT
/solve/report-definitions/add mass-flux flux-massflow zone-names inlet downstream upstream () q
/solve/report-files/add mass-flux-file report-defs mass-flux () print yes file-name Medium_jet_SA_tv5_CFC_re100K_tv5_mass_flux_data.csv q
/solve/report-plots/add mass-flux-plot report-defs mass-flux () active yes q q



/solve/initialize/hyb-initialization

/solve/iterate 50000

/plot/residuals-set/plot-to-file Medium_jet_SA_CFC_re100K_tv5_residuals_data.txt
/plot/residuals yes yes yes yes yes



